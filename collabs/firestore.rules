rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function allowedPath(uid) { return /databases/$(database)/documents/allowedUsers/$(uid); }
    function isAllowed(uid) {
      return exists(allowedPath(uid)) && get(allowedPath(uid)).data.enabled == true;
    }
    function member() { return signedIn() && isAllowed(request.auth.uid); }
    function isModeratorOf(ownerUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/moderatorAccess/$(ownerUid)/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/moderatorAccess/$(ownerUid)/users/$(request.auth.uid)).data.enabled == true;
    }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function goodDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function goodTime(t) { return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function goodWindow(d) {
      return goodDate(d.date) && goodTime(d.start) && goodTime(d.end) && (d.start != d.end || (d.start == '00:00' && d.end == '00:00'));
    }
    function goodMember(d) {
      return d.keys().hasAll(['nick','twitch','steam','telegram','telegramDM','youtube','tiktok','discord','weekdays','weekend','updatedAt'])
        && d.keys().hasOnly(['nick','twitch','steam','telegram','telegramDM','youtube','tiktok','discord','weekdays','weekend','updatedAt'])
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 40
        && d.twitch is string && d.twitch.size() <= 300
        && d.steam is string && d.steam.size() <= 300
        && d.telegram is string && d.telegram.size() <= 300
        && d.telegramDM is string && d.telegramDM.size() <= 300
        && d.youtube is string && d.youtube.size() <= 300
        && d.tiktok is string && d.tiktok.size() <= 300
        && d.discord is string && d.discord.size() <= 300
        && d.weekdays is string && d.weekdays.size() <= 80
        && d.weekend is string && d.weekend.size() <= 80
        && d.updatedAt is timestamp;
    }
    function goodSlot(d) {
      return d.keys().hasAll(['ownerUid','date','start','end','type','title','public','updatedAt'])
        && d.keys().hasOnly(['ownerUid','date','start','end','type','title','details','public','updatedAt',
          'guestNick','showGame','showGuest'])
        && d.ownerUid is string && d.ownerUid.size() <= 128
        && goodWindow(d)
        && d.type in ['stream','collab','off','busy','maybe','free']
        && d.title is string && d.title.size() <= 90
        && d.get('details','') is string && d.get('details','').size() <= 500
        && d.get('guestNick','') is string && d.get('guestNick','').size() <= 80
        && d.get('showGame',false) is bool && d.get('showGuest',false) is bool
        && (d.type != 'collab' || (d.keys().hasAll(['guestNick','showGame','showGuest'])
          && d.guestNick.size() >= 1))
        && (d.type == 'collab' || (d.get('guestNick','') == ''
          && d.get('showGame',false) == false && d.get('showGuest',false) == false))
        && d.public is bool && (d.type in ['stream','off','collab'] || d.public == false)
        && d.updatedAt is timestamp;
    }
    function validWishChoice(t) {
      return t is map && t.keys().hasAll(['date','start','end'])
        && t.keys().hasOnly(['date','start','end']) && goodWindow(t);
    }
    function validWishOptions(d) {
      return !d.keys().hasAny(['timeOptions']) || (
        d.timeOptions is list && d.timeOptions.size() >= 1 && d.timeOptions.size() <= 5
        && validWishChoice(d.timeOptions[0])
        && d.timeOptions[0].date == d.date
        && d.timeOptions[0].start == d.start
        && d.timeOptions[0].end == d.end
        && (d.timeOptions.size() < 2 || validWishChoice(d.timeOptions[1]))
        && (d.timeOptions.size() < 3 || validWishChoice(d.timeOptions[2]))
        && (d.timeOptions.size() < 4 || validWishChoice(d.timeOptions[3]))
        && (d.timeOptions.size() < 5 || validWishChoice(d.timeOptions[4]))
      );
    }
    function allowedSelectedTime(oldData, newData) {
      return oldData.keys().hasAny(['timeOptions'])
        && newData.chosenIndex is int
        && newData.chosenIndex >= 0 && newData.chosenIndex < oldData.timeOptions.size()
        && validWishChoice(oldData.timeOptions[newData.chosenIndex])
        && newData.date == oldData.timeOptions[newData.chosenIndex].date
        && newData.start == oldData.timeOptions[newData.chosenIndex].start
        && newData.end == oldData.timeOptions[newData.chosenIndex].end;
    }
    function goodProposal(d) {
      return d.keys().hasAll(['fromUid','toUid','fromName','toName','date','start','end','game','message','status','createdAt','respondedAt'])
        && d.keys().hasOnly(['fromUid','toUid','fromName','toName','date','start','end','game','message','status','createdAt','respondedAt','replacesId','timeOptions'])
        && d.fromUid is string && d.fromUid.size() <= 128
        && d.toUid is string && d.toUid.size() <= 128
        && d.fromUid != d.toUid
        && d.fromName is string && d.fromName.size() <= 40
        && d.toName is string && d.toName.size() <= 40
        && goodWindow(d)
        && d.game is string && d.game.size() >= 1 && d.game.size() <= 90
        && d.message is string && d.message.size() <= 500
        && d.get('replacesId','') is string && d.get('replacesId','').size() <= 128
        && validWishOptions(d)
        && d.status == 'pending'
        && d.createdAt is timestamp && d.respondedAt == null;
    }
    function goodLock(d) {
      return d.keys().hasAll(['fromUid','toUid','date','start','end','game'])
        && d.keys().hasOnly(['fromUid','toUid','date','start','end','game','fromName','toName'])
        && d.fromUid is string && d.toUid is string
        && goodWindow(d) && d.game is string && d.game.size() <= 90
        && (!('fromName' in d) || (d.fromName is string && d.fromName.size() <= 40))
        && (!('toName' in d) || (d.toName is string && d.toName.size() <= 40));
    }

    // Доступ организатор настраивает вручную в Firebase Console.
    match /allowedUsers/{uid} {
      allow get: if me(uid);
      allow list, create, update, delete: if false;
    }

    // Ник и соцсети доступны только приглашённым участницам.
    match /members/{uid} {
      allow get: if member() || isModeratorOf(uid);
      allow list: if member();
      allow create, update: if member() && me(uid) && goodMember(request.resource.data);
      allow delete: if false;
    }

    // Закрытое расписание: читать могут участницы, менять — только автор.
    match /slots/{slotId} {
      allow read: if member() || isModeratorOf(resource.data.ownerUid);
      allow create: if member() && request.resource.data.ownerUid == request.auth.uid
        && goodSlot(request.resource.data);
      allow update: if member() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && goodSlot(request.resource.data);
      allow delete: if member() && resource.data.ownerUid == request.auth.uid;
    }

    // Предложения видны только отправителю и получателю.
    match /proposals/{proposalId} {
      allow get, list: if member() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if member()
        && request.resource.data.fromUid == request.auth.uid
        && isAllowed(request.resource.data.toUid)
        && goodProposal(request.resource.data)
        && (request.resource.data.get('replacesId','') == '' ||
            (exists(/databases/$(database)/documents/collabLocks/$(request.resource.data.replacesId))
              && request.resource.data.fromUid in [
                get(/databases/$(database)/documents/collabLocks/$(request.resource.data.replacesId)).data.fromUid,
                get(/databases/$(database)/documents/collabLocks/$(request.resource.data.replacesId)).data.toUid
              ]
              && request.resource.data.toUid in [
                get(/databases/$(database)/documents/collabLocks/$(request.resource.data.replacesId)).data.fromUid,
                get(/databases/$(database)/documents/collabLocks/$(request.resource.data.replacesId)).data.toUid
              ]));

      allow update: if member()
        && request.resource.data.respondedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt','chosenIndex','date','start','end'])
        && (
          (resource.data.toUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted','declined']
            && (
              (request.resource.data.status == 'declined'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']))
              ||
              (request.resource.data.status == 'accepted'
                && (
                  (!resource.data.keys().hasAny(['timeOptions'])
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']))
                  ||
                  (resource.data.keys().hasAny(['timeOptions'])
                    && allowedSelectedTime(resource.data, request.resource.data))
                ))
            ))
          ||
          (resource.data.fromUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']))
          ||
          ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']))
        );
      allow delete: if false;
    }

    // Подтверждённый коллаб блокирует обоих, но не раскрывает приглашение/сообщение.
    match /collabLocks/{proposalId} {
      allow read: if member() || isModeratorOf(resource.data.fromUid) || isModeratorOf(resource.data.toUid);
      allow create: if member()
        && goodLock(request.resource.data)
        && request.resource.data.toUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromUid == request.resource.data.fromUid
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid == request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.start == request.resource.data.start
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.end == request.resource.data.end
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.game == request.resource.data.game
        && request.resource.data.fromName == getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromName
        && request.resource.data.toName == getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toName;
      allow delete: if member()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // Публичный раздел содержит ОТДЕЛЬНУЮ копию только выбранных стримов.
    // Анонимный зритель не имеет доступа к закрытым коллекциям.
    match /publicSchedules/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if member() && me(uid)
        && request.resource.data.keys().hasAll(['nick','twitch','telegram','youtube','tiktok','discord','events','updatedAt'])
        && request.resource.data.keys().hasOnly(['nick','twitch','telegram','youtube','tiktok','discord','events','updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 40
        && request.resource.data.twitch is string && request.resource.data.twitch.size() <= 300
        && request.resource.data.telegram is string && request.resource.data.telegram.size() <= 300
        && request.resource.data.youtube is string && request.resource.data.youtube.size() <= 300
        && request.resource.data.tiktok is string && request.resource.data.tiktok.size() <= 300
        && request.resource.data.discord is string && request.resource.data.discord.size() <= 300
        && request.resource.data.events is list && request.resource.data.events.size() <= 300
        && request.resource.data.updatedAt is timestamp;
      allow delete: if member() && me(uid);
    }


    // Доступ модератора выдаёт администратор Firebase вручную.
    // Модераторское приглашение на URL НЕ является авторизацией.
    match /moderatorAccess/{ownerUid}/users/{moderatorUid} {
      allow get: if me(moderatorUid);
      allow list, create, update, delete: if false;
    }

    // Модератор видит только безопасные анонсы ожидающих приглашений (без переписки).
    function validPendingPreview(d, proposalId, ownerUid) {
      let p = getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data;
      return d.keys().hasAll(['fromUid','toUid','fromName','toName','date','start','end','game'])
        && d.keys().hasOnly(['fromUid','toUid','fromName','toName','date','start','end','game'])
        && d.fromUid == p.fromUid && d.toUid == p.toUid
        && d.fromName == p.fromName && d.toName == p.toName
        && d.date == p.date && d.start == p.start && d.end == p.end && d.game == p.game
        && p.status == 'pending' && p.fromUid == request.auth.uid
        && ownerUid in [p.fromUid,p.toUid];
    }

    match /moderatorPending/{ownerUid}/items/{proposalId} {
      allow read: if isModeratorOf(ownerUid);
      allow create: if member() && validPendingPreview(request.resource.data, proposalId, ownerUid);
      allow delete: if member()
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.status in ['accepted','declined','cancelled']
        && request.auth.uid in [
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromUid,
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid
        ]
        && ownerUid in [
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromUid,
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid
        ];
      allow update: if false;
    }

    // Зритель видит только то, что участник коллабы явно раскрыл для СВОЕГО канала.
    // Игра/партнёр по умолчанию пустые, сообщения не сохраняются в публичной коллекции.
    function validPublicMarker(d, ownerUid, proposalId) {
      let lock = getAfter(/databases/$(database)/documents/collabLocks/$(proposalId)).data;
      return d.keys().hasAll(['type','date','start','end','game','partner'])
        && d.keys().hasOnly(['type','date','start','end','game','partner'])
        && d.type == 'collab' && goodWindow(d)
        && ownerUid in [lock.fromUid,lock.toUid]
        && d.date == lock.date && d.start == lock.start && d.end == lock.end
        && d.game is string && d.game.size() <= 90
        && (d.game == '' || d.game == lock.game)
        && d.partner is string && d.partner.size() <= 40;
    }

    match /publicCollabs/{ownerUid}/items/{proposalId} {
      allow get, list: if true;

      // Получатель принимает приглашение и атомарно создаёт пустые маркеры для обоих.
      // Также каждый участник может восстановить свой собственный маркер из старой коллабы.
      allow create: if member() && validPublicMarker(request.resource.data, ownerUid, proposalId)
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.status == 'accepted'
        && (
          (request.auth.uid == getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid
            && request.resource.data.game == '' && request.resource.data.partner == '')
          ||
          (ownerUid == request.auth.uid)
        );

      // Пользователь не может менять публичные поля партнёра.
      allow update: if member() && me(ownerUid)
        && validPublicMarker(request.resource.data, ownerUid, proposalId);

      allow delete: if member()
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.status == 'cancelled'
        && request.auth.uid in [
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromUid,
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid
        ]
        && ownerUid in [
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromUid,
          getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid
        ];
    }


    // GROUP COLLABS — all invitees select several acceptable dates; only the
    // organizer can finalize one date approved by every invitee.
    function groupMember(g, uid) {
      return uid == g.organizerUid || uid in g.inviteeUids;
    }
    function validGroupOptions(o) {
      return o is list && o.size() >= 1 && o.size() <= 5
        && validWishChoice(o[0])
        && (o.size() < 2 || validWishChoice(o[1]))
        && (o.size() < 3 || validWishChoice(o[2]))
        && (o.size() < 4 || validWishChoice(o[3]))
        && (o.size() < 5 || validWishChoice(o[4]));
    }
    function validGroupCreate(g) {
      return g.keys().hasAll(['organizerUid','organizerName','inviteeUids','inviteeNames',
        'game','message','options','responses','status','chosenIndex','createdAt','updatedAt'])
        && g.keys().hasOnly(['organizerUid','organizerName','inviteeUids','inviteeNames',
        'game','message','options','responses','status','chosenIndex','createdAt','updatedAt'])
        && g.organizerUid == request.auth.uid
        && g.organizerName is string && g.organizerName.size() >= 2 && g.organizerName.size() <= 40
        && g.inviteeUids is list && g.inviteeUids.size() >= 1 && g.inviteeUids.size() <= 10
        && !(request.auth.uid in g.inviteeUids)
        && g.inviteeUids.toSet().size() == g.inviteeUids.size()
        && g.inviteeNames is list && g.inviteeNames.size() == g.inviteeUids.size()
        && g.game is string && g.game.size() >= 1 && g.game.size() <= 90
        && g.message is string && g.message.size() <= 500
        && validGroupOptions(g.options)
        && g.responses is map && g.responses.size() == 0
        && g.status == 'collecting' && g.chosenIndex == -1
        && g.createdAt is timestamp && g.updatedAt is timestamp;
    }
    function validGroupReply(g, uid) {
      let options = g.responses[uid];
      return options is list && options.size() >= 1 && options.size() <= 5
        && options.toSet().size() == options.size()
        && options[0] is int && options[0] >= 0 && options[0] < g.options.size()
        && (options.size() < 2 || (options[1] is int && options[1] >= 0 && options[1] < g.options.size()))
        && (options.size() < 3 || (options[2] is int && options[2] >= 0 && options[2] < g.options.size()))
        && (options.size() < 4 || (options[3] is int && options[3] >= 0 && options[3] < g.options.size()))
        && (options.size() < 5 || (options[4] is int && options[4] >= 0 && options[4] < g.options.size()));
    }
    function groupApproves(g, i) {
      return g.inviteeUids.size() <= i ||
        (g.responses.get(g.inviteeUids[i], []) is list &&
         g.chosenIndex in g.responses.get(g.inviteeUids[i], []));
    }
    function allGroupApprove(g) {
      return groupApproves(g,0) && groupApproves(g,1) && groupApproves(g,2)
        && groupApproves(g,3) && groupApproves(g,4) && groupApproves(g,5)
        && groupApproves(g,6) && groupApproves(g,7) && groupApproves(g,8)
        && groupApproves(g,9);
    }
    match /groupWishes/{groupId} {
      allow get, list: if member() && groupMember(resource.data, request.auth.uid);
      allow create: if member() && validGroupCreate(request.resource.data);
      allow update: if member() && (
        // Recipient may change only their own availability answer.
        (resource.data.status == 'collecting'
          && request.auth.uid in resource.data.inviteeUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses','updatedAt'])
          && request.resource.data.responses.diff(resource.data.responses).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.updatedAt is timestamp
          && validGroupReply(request.resource.data, request.auth.uid))
        ||
        // Organizer chooses ONE offered option approved by ALL invited users.
        (resource.data.status == 'collecting'
          && request.auth.uid == resource.data.organizerUid
          && request.resource.data.status == 'confirmed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','chosenIndex','updatedAt'])
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.chosenIndex is int
          && request.resource.data.chosenIndex >= 0
          && request.resource.data.chosenIndex < resource.data.options.size()
          && allGroupApprove(request.resource.data))
        ||
        // Cancellation may be initiated by any invited participant.
        (resource.data.status in ['collecting','confirmed']
          && groupMember(resource.data, request.auth.uid)
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.updatedAt is timestamp)
      );
      allow delete: if false;
    }

    // A group diary is available to room members and authorized moderators.
    // It has no private invite messages; all writes are validated against groupWishes.
    function groupDoc(id) {
      return getAfter(/databases/$(database)/documents/groupWishes/$(id)).data;
    }
    function diaryOwner(g, ownerUid) {
      return ownerUid == g.organizerUid || ownerUid in g.inviteeUids;
    }
    function validGroupDiary(d, groupId, ownerUid) {
      let g = groupDoc(groupId);
      return d.keys().hasAll(['organizerUid','organizerName','participants',
        'game','date','start','end','status'])
        && d.keys().hasOnly(['organizerUid','organizerName','participants',
        'game','date','start','end','status'])
        && d.organizerUid == g.organizerUid
        && d.organizerName == g.organizerName
        && d.game == g.game
        && d.participants is list
        && d.participants == [g.organizerName].concat(g.inviteeNames)
        && diaryOwner(g,ownerUid)
        && (
          (g.status == 'collecting' && d.status == 'collecting'
            && d.date == g.options[0].date && d.start == g.options[0].start && d.end == g.options[0].end)
          ||
          (g.status == 'confirmed' && d.status == 'confirmed'
            && d.date == g.options[g.chosenIndex].date
            && d.start == g.options[g.chosenIndex].start
            && d.end == g.options[g.chosenIndex].end)
        );
    }
    match /groupDiary/{ownerUid}/items/{groupId} {
      allow read: if member() || isModeratorOf(ownerUid);
      allow create: if member() && request.auth.uid == groupDoc(groupId).organizerUid
        && validGroupDiary(request.resource.data,groupId,ownerUid);
      allow update: if member() && request.auth.uid == groupDoc(groupId).organizerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','date','start','end'])
        && validGroupDiary(request.resource.data,groupId,ownerUid);
      allow delete: if member()
        && groupDoc(groupId).status == 'cancelled'
        && groupMember(groupDoc(groupId),request.auth.uid)
        && diaryOwner(groupDoc(groupId),ownerUid);
    }

    // Flat confirmed-group calendar is queryable by all authorized streamers.
    function validGroupCalendar(d, id) {
      let g = groupDoc(id);
      return d.keys().hasAll(['organizerUid','participantsUids','participants','game','date','start','end'])
        && d.keys().hasOnly(['organizerUid','participantsUids','participants','game','date','start','end'])
        && g.status == 'confirmed'
        && d.organizerUid == g.organizerUid && d.game == g.game
        && d.participantsUids is list
        && d.participantsUids.size() == g.inviteeUids.size() + 1
        && d.participants is list && d.participants.size() == d.participantsUids.size()
        && d.participantsUids == [g.organizerUid].concat(g.inviteeUids)
        && d.participants == [g.organizerName].concat(g.inviteeNames)
        && d.date == g.options[g.chosenIndex].date
        && d.start == g.options[g.chosenIndex].start
        && d.end == g.options[g.chosenIndex].end;
    }
    match /groupCalendar/{groupId} {
      allow read: if member();
      allow create: if member() && request.auth.uid == groupDoc(groupId).organizerUid
        && validGroupCalendar(request.resource.data,groupId);
      allow delete: if member() && groupDoc(groupId).status == 'cancelled'
        && groupMember(groupDoc(groupId),request.auth.uid);
      allow update: if false;
    }

    // Public group markers: generic label and hours only, no private messages.
    function goodGroupPublic(d,groupId,ownerUid) {
      let g = groupDoc(groupId);
      return d.keys().hasAll(['date','start','end','type','game','partner'])
        && d.keys().hasOnly(['date','start','end','type','game','partner'])
        && g.status == 'confirmed' && diaryOwner(g,ownerUid)
        && d.date == g.options[g.chosenIndex].date
        && d.start == g.options[g.chosenIndex].start
        && d.end == g.options[g.chosenIndex].end
        && d.type == 'collab'
        && d.game is string && d.game.size() <= 90 && (d.game == '' || d.game == g.game)
        && d.partner is string && d.partner.size() <= 40;
    }
    match /publicGroupCollabs/{ownerUid}/items/{groupId} {
      allow get, list: if true;
      allow create: if member() && request.auth.uid == groupDoc(groupId).organizerUid
        && goodGroupPublic(request.resource.data,groupId,ownerUid)
        && request.resource.data.game == '' && request.resource.data.partner == '';
      allow update: if member() && me(ownerUid)
        && goodGroupPublic(request.resource.data,groupId,ownerUid);
      allow delete: if member() && groupDoc(groupId).status == 'cancelled'
        && groupMember(groupDoc(groupId),request.auth.uid)
        && diaryOwner(groupDoc(groupId),ownerUid);
    }

    // Only the authenticated owner reads and writes Twitch segment mappings.
    // Twitch tokens are never written to Firestore.
    function goodTwitchLink(d, ownerUid, sourceId) {
      return d.keys().hasAll(['ownerUid','sourceId','segmentId','broadcasterId','date','start','end','title','updatedAt'])
        && d.keys().hasOnly(['ownerUid','sourceId','segmentId','broadcasterId','date','start','end','title','updatedAt'])
        && d.ownerUid == ownerUid && d.sourceId == sourceId
        && d.segmentId is string && d.segmentId.size() >= 1 && d.segmentId.size() <= 512
        && d.broadcasterId is string && d.broadcasterId.matches('^[0-9]+$')
        && d.date is string && d.date.size() == 10
        && d.start is string && d.start.size() == 5
        && d.end is string && d.end.size() == 5
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 140
        && d.updatedAt is timestamp;
    }
    match /twitchExportLinks/{ownerUid}/items/{sourceId} {
      allow get, list: if member() && me(ownerUid);
      allow create: if member() && me(ownerUid)
        && goodTwitchLink(request.resource.data,ownerUid,sourceId);
      allow update: if member() && me(ownerUid)
        && resource.data.ownerUid == ownerUid
        && request.resource.data.segmentId == resource.data.segmentId
        && request.resource.data.broadcasterId == resource.data.broadcasterId
        && goodTwitchLink(request.resource.data,ownerUid,sourceId);
      allow delete: if member() && me(ownerUid);
    }

    // Manual off-platform guests belong to a confirmed organizer-led session.
    // Room-only visibility. Guests never receive private data or account rights.
    function goodCollabGuests(d){
      return d.keys().hasAll(['ownerUid','date','start','end','game','guestNames','updatedAt'])
        && d.keys().hasOnly(['ownerUid','date','start','end','game','guestNames','updatedAt'])
        && d.ownerUid == request.auth.uid
        && goodDate(d.date) && goodTime(d.start) && goodTime(d.end)
        && d.start != d.end
        && d.game is string && d.game.size() >= 1 && d.game.size() <= 90
        && d.guestNames is list && d.guestNames.size() <= 15
        && d.guestNames.toSet().size() == d.guestNames.size()
        && d.updatedAt is timestamp;
    }
    match /collabGuests/{sessionId} {
      allow read: if member();
      allow create: if member() && goodCollabGuests(request.resource.data);
      allow update: if member() && resource.data.ownerUid == request.auth.uid
        && goodCollabGuests(request.resource.data);
      allow delete: if member() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}