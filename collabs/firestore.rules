rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function allowedPath(uid) { return /databases/$(database)/documents/allowedUsers/$(uid); }
    function isAllowed(uid) {
      return exists(allowedPath(uid)) && get(allowedPath(uid)).data.enabled == true;
    }
    function member() { return signedIn() && isAllowed(request.auth.uid); }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function goodDate(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function goodTime(t) { return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function goodWindow(d) {
      return goodDate(d.date) && goodTime(d.start) && goodTime(d.end) && d.start != d.end;
    }
    function goodMember(d) {
      return d.keys().hasAll(['nick','twitch','steam','weekdays','weekend','updatedAt'])
        && d.keys().hasOnly(['nick','twitch','steam','weekdays','weekend','updatedAt'])
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 40
        && d.twitch is string && d.twitch.size() <= 300
        && d.steam is string && d.steam.size() <= 300
        && d.weekdays is string && d.weekdays.size() <= 80
        && d.weekend is string && d.weekend.size() <= 80
        && d.updatedAt is timestamp;
    }
    function goodSlot(d) {
      return d.keys().hasAll(['ownerUid','date','start','end','type','title','public','updatedAt'])
        && d.keys().hasOnly(['ownerUid','date','start','end','type','title','public','updatedAt'])
        && d.ownerUid is string && d.ownerUid.size() <= 128
        && goodWindow(d)
        && d.type in ['stream','busy','maybe','free']
        && d.title is string && d.title.size() <= 90
        && d.public is bool && (d.type == 'stream' || d.public == false)
        && d.updatedAt is timestamp;
    }
    function goodProposal(d) {
      return d.keys().hasAll(['fromUid','toUid','fromName','toName','date','start','end','game','message','status','createdAt','respondedAt'])
        && d.keys().hasOnly(['fromUid','toUid','fromName','toName','date','start','end','game','message','status','createdAt','respondedAt'])
        && d.fromUid is string && d.fromUid.size() <= 128
        && d.toUid is string && d.toUid.size() <= 128
        && d.fromUid != d.toUid
        && d.fromName is string && d.fromName.size() <= 40
        && d.toName is string && d.toName.size() <= 40
        && goodWindow(d)
        && d.game is string && d.game.size() >= 1 && d.game.size() <= 90
        && d.message is string && d.message.size() <= 500
        && d.status == 'pending'
        && d.createdAt is timestamp && d.respondedAt == null;
    }
    function goodLock(d) {
      return d.keys().hasAll(['fromUid','toUid','date','start','end','game'])
        && d.keys().hasOnly(['fromUid','toUid','date','start','end','game'])
        && d.fromUid is string && d.toUid is string
        && goodWindow(d) && d.game is string && d.game.size() <= 90;
    }

    // Доступ организатор настраивает вручную в Firebase Console.
    match /allowedUsers/{uid} {
      allow get: if me(uid);
      allow list, create, update, delete: if false;
    }

    // Ник и соцсети доступны только приглашённым участницам.
    match /members/{uid} {
      allow read: if member();
      allow create, update: if member() && me(uid) && goodMember(request.resource.data);
      allow delete: if false;
    }

    // Закрытое расписание: читать могут участницы, менять — только автор.
    match /slots/{slotId} {
      allow read: if member();
      allow create: if member() && request.resource.data.ownerUid == request.auth.uid
        && goodSlot(request.resource.data);
      allow update: if member() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && goodSlot(request.resource.data);
      allow delete: if member() && resource.data.ownerUid == request.auth.uid;
    }

    // Предложения видны только отправителю и получателю.
    match /proposals/{proposalId} {
      allow get, list: if member() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if member()
        && request.resource.data.fromUid == request.auth.uid
        && isAllowed(request.resource.data.toUid)
        && goodProposal(request.resource.data);

      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.respondedAt is timestamp
        && (
          (resource.data.toUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted','declined'])
          ||
          (resource.data.fromUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
          ||
          ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    // Подтверждённый коллаб блокирует обоих, но не раскрывает приглашение/сообщение.
    match /collabLocks/{proposalId} {
      allow read: if member();
      allow create: if member()
        && goodLock(request.resource.data)
        && request.resource.data.toUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.fromUid == request.resource.data.fromUid
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.toUid == request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.start == request.resource.data.start
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.end == request.resource.data.end
        && getAfter(/databases/$(database)/documents/proposals/$(proposalId)).data.game == request.resource.data.game;
      allow delete: if member()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    // Публичный раздел содержит ОТДЕЛЬНУЮ копию только выбранных стримов.
    // Анонимный зритель не имеет доступа к закрытым коллекциям.
    match /publicSchedules/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if member() && me(uid)
        && request.resource.data.keys().hasAll(['nick','twitch','events','updatedAt'])
        && request.resource.data.keys().hasOnly(['nick','twitch','events','updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 40
        && request.resource.data.twitch is string && request.resource.data.twitch.size() <= 300
        && request.resource.data.events is list && request.resource.data.events.size() <= 300
        && request.resource.data.updatedAt is timestamp;
      allow delete: if member() && me(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}